[
  {"id": "inspection_done",
   "on": ["flag:inspected_eng", "flag:inspected_hydro", "flag:inspected_med", "quest:q_audit:inspect"],
   "if": "flag('inspected_eng') and flag('inspected_hydro') and flag('inspected_med') and stage('q_audit', 'inspect')",
   "do": ["set_stage('q_audit', 'findings')"]},

  {"id": "reactor_parts_fitted", "on": "repaired:reactor",
   "if": "stage('q_reactor', 'parts')",
   "do": ["set_stage('q_reactor', 'stabilise')"]},
  {"id": "reactor_stable", "on": "tick",
   "if": "quest_active('q_reactor') and cond('reactor') >= 85",
   "do": ["complete_quest('q_reactor')", "add_rel(15, 'bram')", "give_item('tool_belt')",
          "notify('Bram presses a worn tool belt into your hands.')"]},
  {"id": "reactor_lost", "on": "system:reactor:offline",
   "if": "quest_active('q_reactor')",
   "do": ["fail_quest('q_reactor')"]},

  {"id": "lab_demoted", "on": "priority:lab", "once": false,
   "if": "priority('lab') >= 6 and not flag('lab_demoted')",
   "do": ["set_flag('lab_demoted')", "add_rel(-15, 'lin')", "add_rel(8, 'bram')",
          "log('The Research Lab was moved down the power queue.')"]},
  {"id": "lab_promoted", "on": "priority:lab", "once": false,
   "if": "priority('lab') < 6 and flag('lab_demoted')",
   "do": ["clear_flag('lab_demoted')", "add_rel(8, 'lin')"]},

  {"id": "seal_found", "on": "item:pump_seal",
   "if": "stage('q_water', 'find_seal')",
   "do": ["set_stage('q_water', 'fit_seal')"]},
  {"id": "pump_fixed", "on": "flag:pump_fixed",
   "do": ["if not quest_started('q_water'): start_quest('q_water')", "complete_quest('q_water')",
          "announce('Water reclamation is back to full pressure.')", "add_morale(6, 'all')"]},
  {"id": "tanks_dry", "on": "resource:water:critical",
   "do": ["add_morale(-8, 'all')"]},

  {"id": "saw_dex_loading", "on": "npc_delivered:dex",
   "if": "in_map('hangar') and near('dex', 10) and not flag('saw_dex_loading')",
   "do": ["set_flag('saw_dex_loading')", "set_flag('knows_dex_scheme')",
          "notify('You watch Dex stow crates aboard the Magpie. He has not seen you.', 'quest')",
          "if not quest_started('q_smuggler'): start_quest('q_smuggler')",
          "set_stage('q_smuggler', 'proof')", "add_xp(40)"]},
  {"id": "manifest_found", "on": "item:cargo_manifest",
   "do": ["set_flag('knows_dex_scheme')", "if not quest_started('q_smuggler'): start_quest('q_smuggler')",
          "set_stage('q_smuggler', 'proof')", "add_xp(40)"]},
  {"id": "magpie_cargo_seen", "on": "flag:saw_magpie_cargo",
   "do": ["if not quest_started('q_smuggler'): start_quest('q_smuggler')",
          "journal('There are station supplies hidden in the hold of the Magpie.')"]},
  {"id": "dex_arrested", "on": "flag:dex_arrested",
   "do": ["move_items('shuttle_hold', 'stores_food', 'ration_pack')",
          "move_items('shuttle_hold', 'stores_fuel', 'fuel_cell')",
          "move_items('shuttle_hold', 'stores_parts', 'spare_parts')",
          "move_items('dex_locker', 'stores_parts', 'spare_parts')",
          "set_obj('stores_parts', 'restricted', False)", "set_obj('stores_food', 'restricted', False)",
          "set_obj('stores_misc', 'restricted', False)", "set_flag('stores_open')",
          "cancel_goal('dex', 'prep_shuttle')", "cancel_goal('dex', 'flee_station')",
          "add_rel(-60, 'dex')",
          "announce('Security notice: Quartermaster Marlow has been relieved of duty. The stores are open.')",
          "if not quest_started('q_smuggler'): start_quest('q_smuggler')", "complete_quest('q_smuggler')"]},
  {"id": "prisoner_fed", "on": "hour", "once": false,
   "if": "flag('dex_arrested') and present('dex')",
   "do": ["add_need('hunger', -6, 'dex')"]},
  {"id": "dex_flee", "on": "hour",
   "if": "flag('magpie_stocked') and day() >= 5 and time_between(2, 4) and present('dex') and not flag('dex_arrested') and not flag('dex_reformed')",
   "do": ["add_goal('dex', 'flee_station')"]},
  {"id": "magpie_with_player", "on": "magpie_launch", "once": false,
   "if": "flag('leaving_with_dex') and in_map('hangar')",
   "do": ["end_game('magpie')"]},
  {"id": "magpie_gone", "on": "magpie_launch",
   "if": "not (flag('leaving_with_dex') and in_map('hangar')) and present('dex')",
   "do": ["remove_npc('dex')", "set_flag('dex_left')",
          "fill_tiles('hangar', 'objects', 5, 6, 4, 5, '')",
          "remove_obj('shuttle_hold')", "remove_obj('magpie')",
          "announce('Unscheduled launch from the Hangar Bay. The Magpie is gone.')",
          "add_morale(-10, 'all')", "sound('power_down')",
          "if quest_active('q_smuggler'): fail_quest('q_smuggler')"]},

  {"id": "lin_resumes", "on": "hour", "once": false,
   "if": "flag('lin_paused') and time() >= var('lin_resume', 0)",
   "do": ["clear_flag('lin_paused')", "set_schedule('lin', 'obsessive')"]},
  {"id": "signal_decoded", "on": "flag:signal_decoded",
   "do": ["if not quest_started('q_signal'): start_quest('q_signal')",
          "set_stage('q_signal', 'decoded')",
          "add_goal('lin', 'confront_player', priority=80, node='decoded', id='tell_player')",
          "add_goal('lin', 'go_and_wait', priority=72, marker='chamber_spot', until=\"flag('artifact_resolved') or flag('tunnel_sealed')\", label='Waiting in the chamber', id='wait_in_chamber')",
          "set_flag('tuck_wants_charges')",
          "if not flag('tuck_rested') and not flag('tuck_stood_down'): add_goal('tuck', 'seal_tunnel')"]},
  {"id": "tunnel_blown", "on": "tunnel_blown",
   "do": ["set_flag('tunnel_sealed')", "set_flag('artifact_resolved')",
          "if in_region('artifact_chamber'): teleport('excavation', 26, 13)",
          "if npc_in('lin', 'excavation'): move_npc('lin', 'excavation', 27, 13)",
          "fill_tiles('excavation', 'objects', 17, 18, 13, 5, 'rubble')",
          "fill_tiles('excavation', 'overhead', 17, 16, 13, 7, '')",
          "fill_tiles('excavation', 'decor', 15, 17, 16, 7, '')",
          "remove_obj('artifact')", "remove_obj('artifact_side')",
          "if obj_exists('chamber_shard'): remove_obj('chamber_shard')",
          "cancel_goal('lin', 'decode_signal')", "cancel_goal('lin', 'wait_in_chamber')",
          "cancel_goal('lin', 'tell_player')",
          "add_morale(-30, 'lin')", "add_morale(25, 'tuck')",
          "if flag('tuck_charges'): add_rel(-40, 'lin')",
          "announce('Seismic alert: major collapse in the lower excavation.')", "sound('power_down')",
          "if not quest_started('q_signal'): start_quest('q_signal')", "complete_quest('q_signal')"]},

  {"id": "comms_fixed", "on": "flag:comms_fixed",
   "do": ["announce('Comms array: carrier restored.')", "add_morale(8, 'all')",
          "add_goal('pip', 'confront_player', priority=74, node='comms_up', id='tell_comms')",
          "if not quest_started('q_comms'): start_quest('q_comms')", "set_stage('q_comms', 'power')"]},

  {"id": "theft_warning", "on": "theft",
   "if": "var('thefts_seen') >= 2 and not flag('theft_warned') and present('halloran')",
   "do": ["add_goal('halloran', 'confront_player', node='caught', id='warn_thief')"]},

  {"id": "day3_tremor", "on": "hour",
   "if": "day() == 3 and hour() == 9",
   "do": ["announce('Seismic tremor registered. Minor damage reported on several systems.')",
          "damage('water_reclaim', 8)", "damage('drill', 12)", "damage('life_support', 6)", "sound('power_down')"]},

  {"id": "tug_approach", "on": "hour",
   "if": "day() == 5 and hour() == 20",
   "do": ["announce(\"Traffic: MCS Calypso's Thread on final approach. Docking at 08:00.\")"]},
  {"id": "tug_arrives", "on": "hour",
   "if": "day() >= 6 and hour() >= 8",
   "do": ["announce(\"The Calypso's Thread has docked at the main airlock.\")",
          "set_stage('q_audit', 'final')",
          "add_goal('osei', 'go_and_wait', marker='patrol_hangar', until='False', label='Waiting at the airlock', id='wait_airlock')",
          "if present('halloran'): add_goal('halloran', 'go_and_wait', marker='player_start', until='False', label='Waiting at the airlock', id='wait_airlock')"]},
  {"id": "verdict_missed", "on": "hour",
   "if": "day() >= 6 and hour() >= 20 and stage('q_audit', 'final')",
   "do": ["end_game('absent')"]},

  {"id": "air_gone", "on": "tick",
   "if": "res('air') < 14",
   "do": ["end_game('blackout')"]}
]
